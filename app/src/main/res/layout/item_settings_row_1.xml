<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rowRoot"
  android:layout_width="match_parent"
  android:layout_height="52dp"
  android:background="?android:attr/selectableItemBackground"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="16dp">

  <ImageView
    android:id="@+id/imgIcon"
    android:layout_width="22dp"
    android:layout_height="22dp"
    android:importantForAccessibility="no"
    android:tint="@color/style_color_primary" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tvTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="@font/font_family_medium"
      android:maxLines="1"
      android:textColor="@color/style_color_text_primary"
      android:textSize="15sp" />

    <TextView
      android:id="@+id/tvValue"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="@font/font_family_regular"
      android:maxLines="1"
      android:textColor="@color/style_color_text_tertiary"
      android:textSize="12sp"
      android:visibility="gone" />
  </LinearLayout>

  <ImageView
    android:id="@+id/imgTrailing"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:importantForAccessibility="no"
    android:tint="@color/style_color_primary" />
</LinearLayout>
