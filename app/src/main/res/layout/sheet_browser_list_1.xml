<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_v2_sheet"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="10dp">

    <TextView
      android:id="@+id/tvSheetTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="@font/font_family_bold"
      android:textColor="@color/style_color_text_primary"
      android:textSize="18sp" />

    <TextView
      android:id="@+id/tvSheetAction"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_v2_pill"
      android:fontFamily="@font/font_family_semibold"
      android:paddingStart="14dp"
      android:paddingTop="6dp"
      android:paddingEnd="14dp"
      android:paddingBottom="6dp"
      android:textColor="@color/style_color_primary"
      android:textSize="13sp" />
  </LinearLayout>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvEntries"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="420dp" />

  <TextView
    android:id="@+id/tvSheetEmpty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/font_family_regular"
    android:gravity="center"
    android:padding="24dp"
    android:textColor="@color/style_color_text_secondary"
    android:textSize="14sp"
    android:visibility="gone" />
</LinearLayout>
