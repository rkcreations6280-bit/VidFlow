<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="12dp"
  android:background="@drawable/bg_v2_card"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:padding="16dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/font_family_bold"
    android:text="@string/v2_app_version"
    android:textColor="@color/style_color_text_primary"
    android:textSize="17sp" />

  <TextView
    android:id="@+id/tvVersion"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:fontFamily="@font/font_family_regular"
    android:textColor="@color/style_color_text_secondary"
    android:textSize="14sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:fontFamily="@font/font_family_regular"
    android:gravity="center"
    android:text="@string/v2_restart_hint"
    android:textColor="@color/style_color_text_tertiary"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/btnRestart"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/font_family_semibold"
    android:padding="10dp"
    android:text="@string/v2_restart_app"
    android:textColor="@color/style_color_primary"
    android:textSize="15sp" />
</LinearLayout>
