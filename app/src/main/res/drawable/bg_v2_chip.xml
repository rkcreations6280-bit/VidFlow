<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/style_color_primary_container" />
      <corners android:radius="16dp" />
      <stroke android:width="2dp" android:color="@color/style_color_primary" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/style_color_card" />
      <corners android:radius="16dp" />
      <stroke android:width="1.5dp" android:color="#66FF8A00" />
    </shape>
  </item>
</selector>
