<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/NestedScrollView"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToPadding="false"
  android:fillViewport="true"
  android:fitsSystemWindows="true"
  android:paddingBottom="110dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_v2_icon_btn"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:src="@drawable/ic_v2_video"
        android:tint="@color/style_color_primary" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_bold"
          android:text="@string/v2_home_title"
          android:textColor="@color/style_color_text_primary"
          android:textSize="20sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_regular"
          android:text="@string/v2_home_subtitle"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Select local file -->
    <LinearLayout
      android:id="@+id/btnLocal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="20dp"
      android:background="@drawable/bg_v2_card"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="14dp">

      <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_v2_icon_btn"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_v2_folder"
        android:tint="@color/style_color_primary" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_bold"
          android:text="@string/v2_home_local_title"
          android:textColor="@color/style_color_text_primary"
          android:textSize="16sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_regular"
          android:text="@string/v2_home_local_sub"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="12sp" />
      </LinearLayout>

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_keyboard_arrow_right"
        android:tint="@color/style_color_text_secondary" />
    </LinearLayout>

    <!-- URL input -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_bold"
      android:text="@string/v2_home_url_title"
      android:textColor="@color/style_color_text_primary"
      android:textSize="16sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:fontFamily="@font/font_family_regular"
      android:text="@string/v2_home_url_sub"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="12sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="50dp"
      android:layout_marginBottom="14dp"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_v2_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_v2_link"
          android:tint="@color/style_color_text_secondary" />

        <EditText
          android:id="@+id/etVideoUrl"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:background="@null"
          android:fontFamily="@font/font_family_regular"
          android:hint="@string/v2_home_url_hint"
          android:imeOptions="actionGo"
          android:inputType="textUri"
          android:maxLines="1"
          android:paddingStart="8dp"
          android:paddingEnd="8dp"
          android:textColor="@color/style_color_text_primary"
          android:textColorHint="@color/style_color_text_hint"
          android:textSize="14sp" />

        <ImageView
          android:id="@+id/btnPaste"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:contentDescription="@string/v2_cd_paste"
          android:padding="6dp"
          android:src="@drawable/ic_v2_paste"
          android:tint="@color/style_color_primary" />
      </LinearLayout>

      <TextView
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_v2_btn_secondary"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/v2_home_clear"
        android:textColor="@color/style_color_text_primary"
        android:textSize="14sp" />
    </LinearLayout>

    <!-- Play / Fetch -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/btnPlay"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_v2_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_v2_play"
          android:tint="#111111" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:fontFamily="@font/font_family_semibold"
          android:text="@string/v2_home_play"
          android:textColor="#111111"
          android:textSize="15sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnFetch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_v2_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_v2_download"
          android:tint="@color/style_color_primary" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:fontFamily="@font/font_family_semibold"
          android:text="@string/v2_home_fetch"
          android:textColor="@color/style_color_primary"
          android:textSize="15sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- History / Bookmarks -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/bg_v2_card"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/btnHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_v2_history"
          android:tint="@color/style_color_primary" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:fontFamily="@font/font_family_semibold"
          android:text="@string/v2_history"
          android:textColor="@color/style_color_text_primary"
          android:textSize="16sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/btnBookmarks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_v2_bookmark"
          android:tint="@color/style_color_primary" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:fontFamily="@font/font_family_semibold"
          android:text="@string/v2_bookmarks"
          android:textColor="@color/style_color_text_primary"
          android:textSize="16sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Recent downloads -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/font_family_bold"
        android:text="@string/v2_home_recent"
        android:textColor="@color/style_color_text_primary"
        android:textSize="18sp" />

      <TextView
        android:id="@+id/tvViewAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_family_semibold"
        android:padding="4dp"
        android:text="@string/v2_home_view_all"
        android:textColor="@color/style_color_primary"
        android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/historyList"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/tvRecentEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_regular"
      android:gravity="center"
      android:padding="16dp"
      android:text="@string/v2_recent_empty"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="14sp"
      android:visibility="gone" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
