<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_v2_sheet"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v2_sheet_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
      android:id="@+id/imgThumb"
      android:layout_width="96dp"
      android:layout_height="60dp"
      android:background="@drawable/bg_v2_thumb"
      android:clipToOutline="true"
      android:importantForAccessibility="no"
      android:scaleType="centerCrop" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_bold"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

      <TextView
        android:id="@+id/tvUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_v2_url_pill"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_regular"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/btnPlay"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginStart="8dp"
      android:background="@drawable/bg_v2_url_pill"
      android:contentDescription="@string/v2_opt_open"
      android:padding="9dp"
      android:src="@drawable/ic_v2_play"
      android:tint="#FFFFFF" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/optOpen"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_open_in_new_small"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_open"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/optShare"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_share"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_share"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/optClear"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_clear_all"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_clear"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/optDelete"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_delete"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_delete"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/optRename"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_edit"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_rename"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/optLink"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_link"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_link"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/optInfo"
      android:layout_width="0dp"
      android:layout_height="52dp"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_info"
        android:tint="@color/style_color_primary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_medium"
        android:maxLines="1"
        android:text="@string/v2_opt_info"
        android:textColor="@color/style_color_text_primary"
        android:textSize="15sp" />
    </LinearLayout>

    <View
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />
  </LinearLayout>
  </LinearLayout>
</LinearLayout>
